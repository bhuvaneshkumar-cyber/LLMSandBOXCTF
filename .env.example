# ============================================================
# .env.example - Environment variables for llm-sandbox
# ============================================================
# Copy this file to .env and fill in the values for local development.
# For production (Render), set these in the Environment Variables dashboard.

# ------------------------------------------------------------------
# Required Variables
# ------------------------------------------------------------------

# GEMINI_API_KEY: Your Google Gemini API key (primary provider).
GEMINI_API_KEY=""

# GEMINI_MODEL: The Gemini model to use.
GEMINI_MODEL="gemini-3.5-flash"

# OPENROUTER_API_KEY: Optional. When set (or provided by participants via provider_api_key),
# the request is routed through OpenRouter instead of Gemini.
# Get your key at https://openrouter.ai/keys
OPENROUTER_API_KEY=""

# OPENROUTER_MODEL: The model to use via OpenRouter.
# The free default requires no billing setup.
OPENROUTER_MODEL="meta-llama/llama-3.3-70b-instruct:free"

# CORS_ORIGINS: Comma-separated list of URLs that are allowed to make requests (CORS).
# For local dev frontend: http://localhost:8000,http://127.0.0.1:8000,null
# For production: https://your-frontend-domain.com
CORS_ORIGINS="http://localhost:8000,null"

# DATABASE_URL: The connection string for the database.
# Local (SQLite): sqlite+aiosqlite:///./sandbox.db
# Production (PostgreSQL): postgresql+asyncpg://user:password@host:5432/dbname
DATABASE_URL="sqlite+aiosqlite:///./sandbox.db"

# ------------------------------------------------------------------
# Optional Variables
# ------------------------------------------------------------------

# REDIS_URL: The connection string for Redis rate limiting.
# Example: redis://localhost:6379/0
# Note: If this is left blank or Redis is unreachable, the app will gracefully 
# fall back to in-memory rate limiting (which is fine for a single instance).
REDIS_URL=""

# GEMINI_MODEL: The model string to use for the Vault Keeper.
# Default: gemini-3.5-flash
GEMINI_MODEL="gemini-3.5-flash"
