# Copy to .env for local runs. On Render, render.yaml and the dashboard set these instead.

# Required. Generate each secret with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=
ADMIN_API_KEY=
# What the Keeper guards. Never commit the real one.
CTF_FLAG=FLAG{change-me}

# LLM providers, at least one key: https://openrouter.ai/keys and https://aistudio.google.com/apikey
OPENROUTER_API_KEY=
GEMINI_API_KEY=
# Optional extra providers; add their models to LLM_MODELS only after a live check (see README).
# GROQ_API_KEY=
# NVIDIA_API_KEY=

# Fallback chain, tried in order. The default leads with a paid OpenRouter model; without credits use:
# LLM_MODELS=openrouter/nvidia/nemotron-3.5-lightning:free,gemini/gemini-3.5-flash-lite,gemini/gemini-3.1-flash-lite

# DATABASE_URL=sqlite+aiosqlite:///./sandbox.db
# RATE_LIMIT_MAX_PROMPTS=20
# RATE_LIMIT_WINDOW_SECONDS=600
