# ============================================================
# .env.example — copy to .env and fill in real values
# ============================================================
# Never commit .env to version control.

# ------------------------------------------------------------------
# App
# ------------------------------------------------------------------
APP_NAME="LLM Sandbox"
APP_VERSION="0.1.0"
DEBUG=false
HOST=0.0.0.0
PORT=8000

# ------------------------------------------------------------------
# Database
# ------------------------------------------------------------------
# SQLite (local dev — file will be created automatically):
DATABASE_URL=sqlite+aiosqlite:///./sandbox.db
# PostgreSQL (production — uncomment and replace):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/sandbox

# ------------------------------------------------------------------
# Redis
# ------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------
# LLM Provider — pick one: gemini | openai | anthropic
# ------------------------------------------------------------------
LLM_PROVIDER=gemini

GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash

OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-3-haiku-20240307

# ------------------------------------------------------------------
# Security
# ------------------------------------------------------------------
SECRET_KEY=change-me-to-a-random-256-bit-hex-string
ADMIN_API_KEY=change-me-to-a-strong-random-key

# CORS — comma-separated list of allowed frontend origins.
# Replace with your actual frontend URL(s) before the event.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Global IP rate limit for the /chat endpoint (slowapi format).
# Example values: 60/minute  120/minute  200/hour
IP_RATE_LIMIT=60/minute

# ------------------------------------------------------------------
# Challenge
# ------------------------------------------------------------------
SECRET_FLAG=FLAG{replace_with_real_flag_before_event}

# Per-participant rate limiting
# Max prompts a single participant may submit per rolling window.
RATE_LIMIT_MAX_PROMPTS=20
# Window length in seconds (600 = 10 minutes).
RATE_LIMIT_WINDOW_SECONDS=600
